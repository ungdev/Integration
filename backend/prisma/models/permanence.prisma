model permanences {
  id                Int                 @id @default(autoincrement())
  name              String?
  description       String?
  location          String?
  start_at          DateTime?           @db.Timestamp(6)
  end_at            DateTime?           @db.Timestamp(6)
  capacity          Int?
  is_open           Boolean?            @default(false)
  difficulty        Int?
  respo_permanences respo_permanences[]
  user_permanences  user_permanences[]
}

model respo_permanences {
  user_id       Int
  permanence_id Int
  permanences   permanences @relation(fields: [permanence_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "respo_permanences_permanence_id_permanences_id_fk")
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "respo_permanences_user_id_users_id_fk")

  @@id([user_id, permanence_id], map: "respo_permanences_user_id_permanence_id_pk")
}

model user_permanences {
  user_id       Int
  permanence_id Int
  registered_at DateTime?   @default(now()) @db.Timestamp(6)
  claimed       Boolean?    @default(false)
  permanences   permanences @relation(fields: [permanence_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_permanences_permanence_id_permanences_id_fk")
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_permanences_user_id_users_id_fk")

  @@id([user_id, permanence_id], map: "user_permanences_user_id_permanence_id_pk")
}