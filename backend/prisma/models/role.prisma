model roles {
  id               Int                @id @default(autoincrement())
  name             String?            @unique(map: "roles_name_unique")         // Nom du rôle (ex: "Animation", "Bouffe", ...)
  description      String?
  role_points      role_points?
  user_preferences user_preferences[]
  user_roles       user_roles[]
}

model role_points {
  role_points Int   @id(map: "role_points_role_points_pk")
  points      Int?
  roles       roles @relation(fields: [role_points], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_points_role_points_roles_id_fk")
}