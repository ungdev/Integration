model teams {
  id                   Int                    @id @default(autoincrement())
  name                 String?                @unique(map: "teams_name_unique")
  description          String?
  type                 String?
  challenge_validation challenge_validation[]
  team_faction         team_faction[]
  team_shotgun         team_shotgun[]
  user_teams           user_teams[]
}

model team_faction {
  faction_id Int
  team_id    Int
  factions   factions @relation(fields: [faction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "team_faction_faction_id_factions_id_fk")
  teams      teams    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "team_faction_team_id_teams_id_fk")

  @@id([faction_id, team_id], map: "team_faction_faction_id_team_id_pk")
}

model team_shotgun {
  id        Int       @id @default(autoincrement())
  team_id   Int?
  timestamp DateTime? @default(now()) @db.Timestamp(6)          // Timestamp du shotgun
  teams     teams?    @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "team_shotgun_team_id_teams_id_fk")
}